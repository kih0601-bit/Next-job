      "\r\n\t\twindow.dataLayer = window.dataLayer || [];\r\n\t\t\r\n\t\t$(function () {\r\n\t\t\t\tconst now = new Date();\r\n\t\t\t\t\r\n\t\t\t\tconst start = new Date(2026, 1, 30, 0, 0, 0); \r\n\t\t\t\tconst end = new Date(2026, 11, 31, 23, 59, 59);\r\n\r\n\t\t\t\tif (now >= start && now <= end) {\r\n\t\t\t\t\tif (!checkPoupCookie(\"knoc_popup\")) {\r\n\t\t\t\t\t\t//window.open(\"/knoc_popup.jsp\", \"\", \"width=550, height=700,left=0px,top=100px, toolbar=no, menubar=no, scrollbars=yes, resizable=no,location=no,titlebar=no\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\tfunction checkPoupCookie(cookieName) {\r\n\t\t\t\tvar cookie = document.cookie;\r\n\t\t\t\tif (cookie.length > 0) {\r\n\t\t\t\t\treturn cookie.indexOf(cookieName) != -1;\r\n\t\t\t\t} else {\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\tfunction gtag() {\r\n\t\t\tdataLayer.push(arguments);\r\n\t\t}\r\n\t\tgtag('js', new Date());\r\n\t\tgtag('config', 'UA-147085299-1');\r\n\r\n\t\tif (location.hostname == \"www.knoc.co.kr\" && document.location.protocol == 'http:') {\r\n\t\t\tdocument.location.href = document.location.href.replace('http:', 'https:');\r\n\t\t}\r\n\r\n\t\t// �˾�\r\n\t\tfunction setCookie(name, value, expiredays) {\r\n\t\t\tvar todayDate = new Date();\r\n\t\t\ttodayDate.setDate(todayDate.getDate() + expiredays);\r\n\t\t\tdocument.cookie = name + \"=\" + escape(value) + \"; path=/; expires=\" + todayDate.toGMTString() + \";\"\r\n\t\t}\r\n\r\n\t\t// ���̾��˾� �ݱ�\r\n\t\tfunction closeLayerPopup(code) {\r\n\t\t\tif ($(\"input[data-type=pop][data-val=\" + code + \"]\").is(\":checked\") == true) {\r\n\t\t\t\tsetCookie(code, \"done\", 1);\r\n\t\t\t}\r\n\t\t\tdocument.all[code].style.visibility = \"hidden\";\r\n\t\t}\r\n\r\n\t\tfunction getCookie(name) {\r\n\t\t\tvar nameOfCookie = name + \"=\";\r\n\t\t\tvar x = 0;\r\n\t\t\twhile (x <= document.cookie.length) {\r\n\t\t\t\tvar y = (x + nameOfCookie.length);\r\n\t\t\t\tif (document.cookie.substring(x, y) == nameOfCookie) {\r\n\t\t\t\t\tif ((endOfCookie = document.cookie.indexOf(\";\", y)) == -1)\r\n\t\t\t\t\t\tendOfCookie = document.cookie.length;\r\n\t\t\t\t\treturn unescape(document.cookie.substring(y, endOfCookie));\r\n\t\t\t\t}\r\n\t\t\t\tx = document.cookie.indexOf(\" \", x) + 1;\r\n\t\t\t\tif (x == 0)\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\treturn \"\";\r\n\t\t}\r\n\r\n\t\tfunction NUM_FORMAT(v) {\r\n\t\t\tif (parseInt(v) < 10) {\r\n\t\t\t\tv = \"0\" + v;\r\n\t\t\t}\r\n\r\n\t\t\treturn v;\r\n\t\t}\r\n\r\n\t\tfunction printPage() {\r\n\t\t\twindow.print();\r\n\t\t}\r\n\r\n\t\tfunction enterkey() {\r\n\t\t\tlet bg = $('.bg');\r\n\t\t\tlet submenu = $('.dropitem');\r\n\t\t\tif (window.event.keyCode == 13) {\r\n\t\t\t\tsubmenu.css('display', 'none');\r\n\t\t\t\tbg.css('display', 'none');\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t",
